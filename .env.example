# Copy this file to ".env" for local development and fill in real values.
# NEVER commit the real .env file - it is gitignored.
# On Vercel, add the same keys in: Project Settings -> Environment Variables.

# The Zoho mailbox that will authenticate and send the emails
ZOHO_EMAIL=your-zoho-email@example.com

# Zoho app-specific password (NOT your normal account password)
ZOHO_APP_PASSWORD=your-zoho-app-password

# Inbox that receives contact form submissions
ADMIN_EMAIL=admin@example.com
